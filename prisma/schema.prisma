generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Round {
  id          String      @id @default(cuid())
  status      RoundStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  launchedAt  DateTime?
  completedAt DateTime?

  platformTargets PlatformTarget[]
  reviewers       Reviewer[]
  reviews         Review[]
  giftCards       GiftCard[]
  drafts          Draft[]
}

model PlatformTarget {
  id             String   @id @default(cuid())
  round          Round    @relation(fields: [roundId], references: [id])
  roundId        String
  platform       Platform
  giftCardAmount Float    @default(0)
  contactCount   Int      @default(0)
  goalReviews    Int      @default(0)
}

model Reviewer {
  id                   String         @id @default(cuid())
  email                String
  name                 String?
  userType             UserType
  round                Round          @relation(fields: [roundId], references: [id])
  roundId              String
  status               ReviewerStatus @default(CONTACTED)
  outreachAt           DateTime?
  screenshotReceivedAt DateTime?

  reviews   Review[]
  giftCards GiftCard[]
  drafts    Draft[]
}

model Review {
  id            String       @id @default(cuid())
  reviewer      Reviewer     @relation(fields: [reviewerId], references: [id])
  reviewerId    String
  round         Round        @relation(fields: [roundId], references: [id])
  roundId       String
  platform      Platform
  rating        Int?
  reviewText    String?
  screenshotUrl String?
  status        ReviewStatus @default(PENDING)
  publishedAt   DateTime?
  flagReason    String?
  createdAt     DateTime     @default(now())

  giftCard GiftCard?
  draft    Draft?
}

model GiftCard {
  id            String         @id @default(cuid())
  round         Round          @relation(fields: [roundId], references: [id])
  roundId       String
  reviewer      Reviewer       @relation(fields: [reviewerId], references: [id])
  reviewerId    String
  review        Review         @relation(fields: [reviewId], references: [id])
  reviewId      String         @unique
  platform      Platform
  amount        Float
  status        GiftCardStatus @default(PENDING_APPROVAL)
  approvedAt    DateTime?
  sentAt        DateTime?
  amazonOrderId String?
  createdAt     DateTime       @default(now())
}

model Draft {
  id             String      @id @default(cuid())
  round          Round       @relation(fields: [roundId], references: [id])
  roundId        String
  reviewer       Reviewer    @relation(fields: [reviewerId], references: [id])
  reviewerId     String
  review         Review?     @relation(fields: [reviewId], references: [id])
  reviewId       String?     @unique
  type           DraftType
  subject        String?
  body           String
  publicResponse String?
  status         DraftStatus @default(PENDING_APPROVAL)
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
}

model PlatformStats {
  id            String   @id @default(cuid())
  platform      Platform @unique
  currentRating Float?
  reviewCount   Int      @default(0)
  goalRating    Float?
  lastChecked   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Platform {
  G2
  CAPTERRA
  TRUSTPILOT
  GOOGLE
  APP_STORE
  GOOGLE_PLAY
}

enum UserType {
  PO
  TENANT
}

enum RoundStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReviewerStatus {
  CONTACTED
  SCREENSHOT_RECEIVED
  REVIEW_PUBLISHED
  GIFT_CARD_SENT
  OPTED_OUT
}

enum ReviewStatus {
  PENDING
  SCREENSHOT_RECEIVED
  PUBLISHED
  NOT_PUBLISHED
  FLAGGED
}

enum GiftCardStatus {
  PENDING_APPROVAL
  APPROVED
  SENT
  FAILED
}

enum DraftType {
  LOW_STAR_OUTREACH
  PUBLIC_RESPONSE
  THANK_YOU
}

enum DraftStatus {
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}
